#===============================================================================
# ENVIRONMENT  -  differs per machine/deployment. Never commit real values.
#===============================================================================

APP_NAME="My Project"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=my_project
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"


#===============================================================================
# BRANDING  -  what makes this install look like a particular product.
#
# Everything below is optional: leave a key unset and config/branding.php
# supplies a sensible default. See "Rebranding This Template" in README.md.
#===============================================================================

# --- Identity -----------------------------------------------------------------
APP_SHORT_NAME="${APP_NAME}"
APP_COMPANY_NAME="My Company"
APP_TAGLINE=""
APP_DESCRIPTION=""
# Leave blank for "© Copyright {year} {company}. All Rights Reserved."
APP_COPYRIGHT=""
APP_SUPPORT_EMAIL=""
APP_WEBSITE_URL=""

APP_SOCIAL_FACEBOOK=""
APP_SOCIAL_INSTAGRAM=""
APP_SOCIAL_LINKEDIN=""
APP_SOCIAL_TWITTER=""
APP_SOCIAL_YOUTUBE=""

# --- Logos & icons ------------------------------------------------------------
# Paths are relative to public/, or absolute URLs (a CDN works fine).
# Only APP_LOGO is required - the rest fall back to it.
APP_LOGO="images/logo-light.svg"
APP_LOGO_DARK="images/logo-dark.svg"
APP_LOGO_SMALL="images/logo-sm.svg"
# APP_LOGO_LIGHT=
# APP_LOGO_LOGIN=
# APP_LOGO_SIDEBAR=
# APP_LOGO_NAVBAR=
# APP_LOGO_MOBILE=
APP_FAVICON="images/logo-sm.svg"
# APP_APPLE_TOUCH_ICON="images/apple-touch-icon.png"
# APP_OG_IMAGE="images/og-image.png"

# --- Login background ---------------------------------------------------------
# Set APP_BACKGROUND_IMAGE="" to drop the image and use the flat colour.
APP_BACKGROUND_IMAGE="assets/img/bg/bg-3.jpg"
APP_BACKGROUND_COLOR="#0b0a1f"
APP_BACKGROUND_SIZE="cover"
APP_BACKGROUND_POSITION="center"
APP_BACKGROUND_REPEAT="no-repeat"
APP_BACKGROUND_ATTACHMENT="fixed"
# Darken/tint the image, e.g. "rgba(0, 0, 0, 0.5)"
APP_BACKGROUND_OVERLAY="rgba(0, 0, 0, 0)"

# --- Typography ---------------------------------------------------------------
APP_FONT_FAMILY="'Roboto', sans-serif"
# APP_FONT_HEADING="'Poppins', sans-serif"
# Families for fonts.googleapis.com; separate multiple with "|". Blank = none.
APP_GOOGLE_FONTS="Roboto:wght@300;400;500;600;700;800"
APP_FONT_SIZE="13px"

# --- Theme --------------------------------------------------------------------
# Colours are chosen in the app under Settings > Theme Setting (presets in
# config/branding.php). There are no colour keys here any more.
